# Обязательно заполните три значения. Пароли должны различаться.
TELEGRAM_BOT_TOKEN=
USER_PASSWORD=
ADMIN_PASSWORD=

TIMEZONE=Europe/Moscow
SCAN_INTERVAL_MINUTES=15
SCAN_TIMEOUT_SECONDS=600
MIN_VIEWS=10000
MAX_VIDEO_AGE_HOURS=24
MEDIA_RETENTION_HOURS=6
METRICS_RETENTION_HOURS=48
DELIVERY_RETENTION_DAYS=30
DATA_DIR=data
MEDIA_DIR=media
LOG_DIR=logs
LOG_LEVEL=INFO

REQUEST_TIMEOUT=30
SEARCH_WAIT_SECONDS=12
DOWNLOAD_TIMEOUT=120
SOURCE_TIMEOUT=90
REQUEST_DELAY_SECONDS=2
MAX_MEDIA_MB=49
MAX_CANDIDATES=200
SEARCH_LIMIT=15
BROWSER_ENABLED=true
OCR_ENABLED=true
LANGUAGE_THRESHOLD=0.45
QUERY_THRESHOLD=3
QUERY_TTL_HOURS=24
QUERY_COOLDOWN_DAYS=7
RANKING_WEIGHTS={"views":0.4,"likes":0.2,"shares":0.15,"comments":0.1,"freshness":0.1,"breakout":0.05}
